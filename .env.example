# Flutter does not read .env files - this documents the --dart-define
# values the app actually consumes (see lib/main.dart) as a reference,
# since there is no single file the app loads them from at runtime.
#
# For an actual working dev run against the real dev backend, use
# scripts/run-dev.ps1 (already has real dev values filled in) or
# tool/run_dev.sh (points at localhost by default).
#
# Values here are safe-to-share by design: Sentry DSNs, PostHog project API
# keys, and Supabase's publishable/anon key are all meant to be public/
# client-embeddable - they end up baked into the compiled app binary
# either way. Never put a real secret (a service-role key, a signing key,
# etc.) behind a Flutter --dart-define. Dev-only auto-login credentials
# follow a separate, gitignored pattern - see lib/dev_credentials.example.dart.

API_BASE_URL=https://dev-api.docwellness.fit
ENV=development
SENTRY_DSN=
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
